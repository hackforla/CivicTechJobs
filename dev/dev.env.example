# environment file to configure docker containers

# postgres
POSTGRES_DB=<same as SQL_DATABASE>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<same as SQL_PASSWORD>

# Django
DEBUG=True
SECRET_KEY=<random string of length 50>
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1] django
# Origins the CSRF middleware trusts beyond the request host. The SPA runs
# on :3000 and is proxied to Django (which sees a different Host), so the
# browser's `Origin: http://localhost:3000` must be listed here or every
# authenticated POST (e.g. logout) fails the CSRF Origin check.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=<same as POSTGRES_DB>
SQL_USER=postgres
SQL_PASSWORD=<same as POSTGRES_PASSWORD>
SQL_HOST=pgdb
SQL_PORT=5432

# Frontend
# Mirrors the stage shape: Next's rewrites() proxies /api/* and /admin/*
# to the django service, so the browser sees same-origin and the SPA can
# use relative URLs end-to-end. No CORS headers needed anywhere.
#
# This value (`http://django:8000`) is the compose-dev shape (docker
# service DNS). For host-based dev, the Makefile's `FRONTEND_RUN`
# macro overrides it to `http://localhost:8000` so the host Next dev
# server proxies to the host Django process. See next.config.ts.
BACKEND_INTERNAL_URL=http://django:8000
