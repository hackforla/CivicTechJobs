# environment file to configure docker containers

# postgres
POSTGRES_DB=<same as SQL_DATABASE>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<same as SQL_PASSWORD>

# Django
DEBUG=True
SECRET_KEY=<random string of length 50>
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1] django
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=<same as POSTGRES_DB>
SQL_USER=postgres
SQL_PASSWORD=<same as POSTGRES_PASSWORD>
SQL_HOST=pgdb
SQL_PORT=5432

# Frontend
# Mirrors the stage shape: Next's rewrites() proxies /api/* and /admin/*
# to the django service, so the browser sees same-origin and the SPA can
# use relative URLs end-to-end. No CORS headers needed anywhere.
BACKEND_INTERNAL_URL=http://django:8000
